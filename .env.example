# ============================================================
# Orvexa — environment example
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# MongoDB Atlas SRV string or a local instance
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orvexa?retryWrites=true&w=majority
# e.g. mongodb://127.0.0.1:27017/orvexa
MONGODB_URI=your_mongodb_connection_string_here

# --- Auth ---
# Use long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Client ---
CLIENT_URL=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Optional: AI assistant (feature auto-disables when empty) ---
AI_API_KEY=
AI_MODEL=

# --- Optional: Cloudinary file storage (falls back to local disk when empty) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
